# ===========================================
# WhatsApp News Bot - Server Configuration
# ===========================================

# Supabase (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server
PORT=3001
# Optional public URL used for generated user-agent metadata
# BOT_PUBLIC_URL=https://your-app.example.com
# BOT_USER_AGENT_NAME=WhatsAppNewsBot
# BOT_USER_AGENT_VERSION=1.0

# JSON body limits (optional)
# Keep the default small; only a few endpoints (like /api/whatsapp/send-test) should accept large payloads.
# JSON_BODY_LIMIT_DEFAULT=2mb
# JSON_BODY_LIMIT_LARGE=50mb

# Access control
# In production this defaults to enabled unless REQUIRE_BASIC_AUTH=false
REQUIRE_BASIC_AUTH=true
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me
# Optional auth realm shown by browser prompt
# BASIC_AUTH_REALM=WhatsApp News Bot
# Require HTTPS for authenticated routes (default true in production)
# BASIC_AUTH_REQUIRE_HTTPS=true
# Emergency override for weak/basic placeholder passwords (NOT recommended)
# ALLOW_WEAK_BASIC_AUTH=false
# Optional: comma-separated client IP allowlist. Leave empty to allow any IP with credentials.
# Supports exact IPs and IPv4 CIDR ranges.
# ACCESS_ALLOWLIST=203.0.113.10,198.51.100.0/24
# Reverse proxy hops to trust for client IP extraction (Render usually 1)
# TRUST_PROXY_HOPS=1
# Optional auth throttling
# BASIC_AUTH_MAX_ATTEMPTS=20
# BASIC_AUTH_BLOCK_MINUTES=15
# HSTS header max age (seconds) in production HTTPS
# HSTS_MAX_AGE_SECONDS=15552000

# WhatsApp Lease System
# Optional: auto-takeover the lease on startup (not recommended when multiple instances can overlap).
# Default is false; use POST /api/whatsapp/takeover when you explicitly want to force a takeover.
# WHATSAPP_LEASE_AUTO_TAKEOVER=false
# Allow a fresh Render deploy instance to take over once before it has ever connected.
# WHATSAPP_LEASE_DEPLOY_TAKEOVER=false
# Lease duration for the active bot instance. Shorter values reduce stale handoff time after a deploy.
# WHATSAPP_LEASE_TTL_MS=45000
# Session key used in auth_state row.
# Use "primary" on Render/production, and a different value locally (for example "local")
# to avoid local-vs-production lease conflicts.
# WHATSAPP_SESSION_ID=local
# Optional linked-device display label shown in WhatsApp linked devices.
# WHATSAPP_DEVICE_NAME=Anash Bot
# Also accepted for backward compatibility:
# WHATSAPP_DEVICE_LABEL=Anash Bot
# Optional full-history sync mode during initial connect (slower startup).
# WHATSAPP_SYNC_FULL_HISTORY=false
# Optional offline-presence heartbeat interval (ms). 0 disables heartbeat.
# WHATSAPP_PRESENCE_OFFLINE_INTERVAL_MS=300000
# Optional unsafe override: group participants are not valid production Status recipients by default.
# Include group members in the auto Status audience for this single-operator bot.
# Set WHATSAPP_STATUS_ALLOW_GROUP_PARTICIPANT_AUDIENCE=false to require only private/explicit recipients.
WHATSAPP_STATUS_INCLUDE_GROUP_PARTICIPANTS=true
WHATSAPP_STATUS_ALLOW_GROUP_PARTICIPANT_AUDIENCE=unsafe
# Also deliver bot-posted Status to the connected sender account so phone/web can sync its own Status.
WHATSAPP_STATUS_INCLUDE_SENDER=true
# Status audience mode. Use auto for production; explicit limits production Status sends to the configured list.
# WHATSAPP_STATUS_AUDIENCE_MODE=auto
# Optional: comma-separated production recipients for status@broadcast when WHATSAPP_STATUS_AUDIENCE_MODE=explicit.
# Accepts raw numbers, @s.whatsapp.net, or @lid JIDs.
# WHATSAPP_STATUS_AUDIENCE_JIDS=972501234567@s.whatsapp.net,anon_contact_123@lid,972509876543
# Optional: comma-separated recipients for manual Status tests only.
# WHATSAPP_STATUS_TEST_AUDIENCE_JIDS=972501234567@s.whatsapp.net
# Optional maximum outbound image size in bytes before rejecting a download.
# WHATSAPP_MAX_IMAGE_BYTES=16777216
# Optional maximum outbound video size in bytes (used by send-test/manual pipelines).
# WHATSAPP_MAX_VIDEO_BYTES=33554432

# Shabbos Mode (optional)
# SHABBOS_MODE=true
# SHABBOS_LOCATION=Jerusalem

# Post-send update windows (optional)
# WhatsApp native edit window is typically short; keep this low.
# POST_SEND_EDIT_WINDOW_MINUTES=15
# Correction attempt window after initial send (kept within WhatsApp edit limit).
# POST_SEND_CORRECTION_WINDOW_MINUTES=15
# DEFAULT_BATCH_TIMES=07:00,15:00,22:00

# Optional E2E script inputs
# TEST_GROUP_ID=12345-67890@g.us
# TEST_CHANNEL_ID=123456789@newsletter
# E2E_FEED_URL=https://example.com/feed.xml
# E2E_STATUS_FEED_URL=https://example.com/feed.json
